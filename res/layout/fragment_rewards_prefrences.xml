<?xml version="1.0" encoding="utf-8"?>
<FrameLayout android:theme="@style/Theme.Hometown.Light" android:background="@android:color/white" android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="fill_parent">
        <TextView android:textAppearance="@style/TextAppearance.Hometown.Chalk.Bold14" android:padding="@dimen/margin_standard_twothirds" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/margin_standard_twothirds" android:text="@string/rewards_offers_preferences" />
        <TextView android:textAppearance="@style/TextAppearance.Hometown.Chalk.Regular13" android:id="@id/hint" android:paddingBottom="@dimen/margin_standard_twothirds" android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="@string/rewards_offers_preferences_hint" android:paddingStart="@dimen/margin_standard_twothirds" android:paddingEnd="@dimen/margin_standard_twothirds" />
        <LinearLayout android:orientation="vertical" android:id="@id/offer_switch_container" android:visibility="gone" android:layout_width="fill_parent" android:layout_height="wrap_content">
            <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:background="@color/white" android:padding="@dimen/margin_standard_twothirds" android:layout_width="fill_parent" android:layout_height="wrap_content">
                <TextView android:textAppearance="@style/TextAppearance.Hometown.Chalk.Bold14" android:layout_width="0.0dip" android:layout_height="wrap_content" android:text="@string/rewards_offers_preference_tobacco" android:layout_weight="1.0" />
                <Switch android:id="@id/tobacco_switch" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <View android:background="@drawable/list_divider_profile" android:layout_width="fill_parent" android:layout_height="@dimen/account_divider_height" />
            <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:background="@color/white" android:padding="@dimen/margin_standard_twothirds" android:layout_width="fill_parent" android:layout_height="wrap_content">
                <TextView android:textAppearance="@style/TextAppearance.Hometown.Chalk.Bold14" android:layout_width="0.0dip" android:layout_height="wrap_content" android:text="@string/rewards_offers_preference_alcohol" android:layout_weight="1.0" />
                <Switch android:id="@id/alcohol_switch" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <View android:background="@drawable/list_divider_profile" android:layout_width="fill_parent" android:layout_height="@dimen/account_divider_height" />
        </LinearLayout>
        <FrameLayout android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/margin_standard" android:layout_marginBottom="@dimen/margin_standard" android:layout_marginStart="@dimen/margin_standard_twothirds" android:layout_marginEnd="@dimen/margin_standard_twothirds">
            <ProgressBar android:layout_gravity="center" android:id="@id/save_progress" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:indeterminate="true" android:indeterminateOnly="true" style="@style/Widget.AppCompat.ProgressBar" />
            <Button android:id="@id/save_btn" android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="@string/save_changes" />
        </FrameLayout>
    </LinearLayout>
    <include layout="@layout/full_screen_loading_state_root" />
</FrameLayout>
